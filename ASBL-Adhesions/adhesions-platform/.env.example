# ---------------------------------------------------------------------------
# Julie — agent adhésions & cotisations (CotisAuto™)
# Copie ce fichier en .env.local et remplis les valeurs dont tu as besoin.
# Rien n'est obligatoire pour démarrer : sans ANTHROPIC_API_KEY, l'app tourne
# en mode démo (mock) avec des membres d'exemple.
# ---------------------------------------------------------------------------

# Clé API Anthropic (https://console.anthropic.com → API Keys).
# Absente ou DEMO_MOCK=1 → l'agent répond avec un livrable de démonstration.
ANTHROPIC_API_KEY=

# Force le mode démo même si une clé Anthropic est présente (1 = actif).
DEMO_MOCK=

# ---------------------------------------------------------------------------
# Source de vérité pour les membres : "sheets" (Google Sheets) ou "airtable".
# Laisse vide (ou une valeur non configurée) pour rester sur les membres
# d'exemple (src/data/mockMembers.ts).
# ---------------------------------------------------------------------------
MEMBERS_BACKEND=

# --- Google OAuth (Sheets + Gmail) -----------------------------------------
# Créer des identifiants OAuth 2.0 "Application Web" dans Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Classeur Google Sheets utilisé comme source de vérité des membres.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Membres

# --- Airtable ----------------------------------------------------------------
# Personal Access Token avec les scopes data.records:read/write + schema.bases:read.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Membres

# --- Informations de l'ASBL (utilisées dans les emails et les attestations) -
ASBL_NAME="Mon ASBL"
ASBL_ADDRESS="Rue Exemple 1, 1000 Bruxelles"
ASBL_REGISTRATION_NUMBER="BE0000.000.000"

# 1 = retire le filigrane "brouillon" des PDF d'attestation générés.
# À n'activer qu'après validation du modèle par le trésorier/comptable de l'ASBL.
CERTIFICATES_VALIDATED=
