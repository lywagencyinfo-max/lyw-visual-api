# ---------------------------------------------------------------------------
# Vanessa — agent gestion des avis Google / réputation (ReputAuto™)
# Copie ce fichier en .env.local et remplis les valeurs dont tu as besoin.
# Rien n'est obligatoire pour démarrer : sans ANTHROPIC_API_KEY, l'app tourne
# en mode démo (mock) avec des avis d'exemple, 100 % fictifs.
# ---------------------------------------------------------------------------

# Clé API Anthropic (https://console.anthropic.com → API Keys).
# Absente ou DEMO_MOCK=1 → l'agent répond avec un livrable de démonstration.
ANTHROPIC_API_KEY=

# Force le mode démo même si une clé Anthropic est présente (1 = actif).
DEMO_MOCK=

# ---------------------------------------------------------------------------
# Google OAuth (Business Profile + Gmail) — natif, pas de SDK tiers.
# Créer des identifiants OAuth 2.0 "Application Web" dans Google Cloud Console
# et activer l'API "Google Business Profile" (My Business API) sur le projet.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Identifiants du Google Business Profile à surveiller (visibles dans
# business.google.com ou via l'API Account Management/Business Information).
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# ---------------------------------------------------------------------------
# Alerte email (Gmail) — envoyée dès qu'un avis ≤ N étoiles arrive ou que la
# note moyenne baisse significativement, pour que le gérant réagisse vite.
# ---------------------------------------------------------------------------
ALERT_EMAIL_TO=

# Seuil (en étoiles, inclus) déclenchant une alerte immédiate sur un nouvel avis.
NEGATIVE_REVIEW_ALERT_THRESHOLD=2

# Seuil de baisse de la note moyenne (fraction, ex. 0.3 = -30 %) sur la
# période récente qui déclenche une alerte "chute de réputation".
RATING_DROP_ALERT_THRESHOLD=0.3

# ---------------------------------------------------------------------------
# Contexte utilisé dans les brouillons de réponse générés par Vanessa.
# ---------------------------------------------------------------------------
BUSINESS_NAME="Mon Établissement"
BUSINESS_CONTACT_EMAIL=contact@mon-etablissement.example
